FROM 912394946097.dkr.ecr.eu-west-1.amazonaws.com/nexus/base-image/build:122 as build

WORKDIR $GOPATH

WORKDIR $GOPATH/src/
COPY ./cmd/blockchain/ethereum/diaAzosNavOracleService ./

RUN go mod download github.com/diadata-org/diadata

RUN go install

FROM gcr.io/distroless/base

COPY --from=build /go/bin/diaAzosNavOracleService /bin/diaAzosNavOracleService
COPY --from=build /config/ /config/

CMD ["diaAzosNavOracleService"]
