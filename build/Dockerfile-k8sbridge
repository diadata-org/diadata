FROM 912394946097.dkr.ecr.eu-west-1.amazonaws.com/nexus/base-image/build:122 as build

WORKDIR $GOPATH/src/
COPY ./cmd/keymanagement/k8sbridge ./
RUN go mod tidy && GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go install

FROM gcr.io/distroless/base

COPY --from=build /go/bin/k8sbridge /bin/k8sbridge

CMD ["k8sbridge"]
