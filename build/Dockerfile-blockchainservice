FROM 912394946097.dkr.ecr.eu-west-1.amazonaws.com/nexus/base-image/build:122 as build

WORKDIR $GOPATH/src/

COPY ./cmd/services/blockchainservice ./
RUN go mod tidy -go=1.16 && go mod tidy -go=1.17 && go install

FROM gcr.io/distroless/base

COPY --from=build /go/bin/blockchainservice /bin/blockchainservice
COPY --from=build /config/ /config/

CMD ["blockchainservice"]
